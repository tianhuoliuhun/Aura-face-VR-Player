<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />

    <!-- ========================================================================
         华为 VR Glass（VR Engine）接入，P0 阶段
         ========================================================================
         官方要求（键名逐条对照官方文档 / 参考项目 Manifest）：
           · GLES 3.2：<uses-feature glEsVersion="0x00030002">
             ⚠️ 这是**硬要求**，且属于「向后兼容」声明，声明 3.2 后，
                普通设备（只要能提供 3.x 上下文）依然可以安装，不影响现有用户。
           · 权限：com.huawei.android.permission.VR
                  com.huawei.vrhandle.permission.DEVICE_MANAGER
         ⚠️ v2.0.198 更新：`com.huawei.android.vr.application.mode=vr_only` **已启用**
            （见下方 application 内的 metadata）。此前因「怕影响 2D 启动行为」而保守搁置，
            但华为官方《申请应用适配华为 VR Glass 上架流程》明确说明：**缺它则 VRLauncher
            不识别本应用**，插上 VR Glass 后在「华为 VR」内容库里看不到 —— 是必需项而非可选项。
            `sensor.mode=mobile` 仍**不启用**（那是调试期临时项，正式包必须无）。
         ⚠️ XML 注释内不能出现连续的双连字符，所以本文件的分隔线只用「=」。
            曾因用了连字符分隔线导致 ManifestMerger 报 not well-formed。
         ======================================================================== -->

    <!-- GLES 3.2（华为硬要求）。required="false" 保证非华为设备不受影响 -->
    <uses-feature
        android:glEsVersion="0x00030002"
        android:required="false" />

    <!-- 华为 VR 权限（未装 VR 运行时的设备上仅是被忽略） -->
    <uses-permission android:name="com.huawei.android.permission.VR" />
    <uses-permission android:name="com.huawei.vrhandle.permission.DEVICE_MANAGER" />

    <!-- ===== PICO（Neo3 / PICO 4 系列）兼容声明 =====
         PICO 与华为都走 Android OpenXR，但各自使用**厂商定制的 loader**：
           华为：libxr_loader.so       （来自 huawei.vr.sdk.dir）
           PICO：libopenxr_loader.so   （来自 PICO OpenXR SDK，同样不入仓）
         下面这些声明对非 PICO 设备**无副作用**（未知 permission / metadata 仅被忽略），
         可与华为的声明共存。

         ⚠️ PICO 的 VR 启动入口（category com.picovr.intent.category.VR）**暂不加**：
            在 PICO 的 loader 接入之前加上，会让 PICO 把应用当 VR 应用启动、随后
            因找不到 loader 而失败 —— 比「不出现 VR 库」更糟。等 loader 就绪后再开启。
         ==================================================================== -->
    <uses-permission android:name="org.khronos.openxr.permission.OPENXR" />
    <uses-permission android:name="org.khronos.openxr.permission.OPENXR_SYSTEM" />
    <!-- OpenXR 标准：标记为支持 VR 头显（required=false 保证普通 Android 设备不受影响） -->
    <uses-feature
        android:name="android.hardware.vr.headtracking"
        android:version="1"
        android:required="false" />
    <uses-feature android:name="oculus.software.handtracking" android:required="false" />

    <!-- API 30+ 包可见性：不声明则查不到华为 VR 运行时 -->
    <queries>
        <package android:name="com.huawei.vrhandle" />
        <package android:name="com.huawei.hvrsdkserverapp" />
        <!-- targetSdk>=30 时不声明则搜不到手柄服务（官方规范明确列出） -->
        <intent>
            <action android:name="com.huawei.vrhandle.service.vrdeviceservice" />
        </intent>
        <intent>
            <action android:name="com.huawei.android.vr.PROMPT" />
        </intent>
        <!-- PICO / 标准 OpenXR：运行时服务发现（API 30+ 包可见性要求） -->
        <intent>
            <action android:name="org.khronos.openxr.OpenXRRuntimeService" />
        </intent>
    </queries>

    <application
        android:name=".AppApplication"
        android:allowBackup="true"
        android:usesCleartextTraffic="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyApplication">

        <!-- v107：统计由 Firebase Analytics 提供（google-services.json 配置，见 FIREBASE_ANALYTICS.md） -->

        <!-- ===== Meta Quest 应用声明 =====
             Quest 与 PICO / 华为一样走 Android OpenXR。三者的差异在 **loader 来源**：
               华为：libxr_loader.so        （华为 SDK 定制）
               PICO：libopenxr_loader.so    （PICO SDK 定制）
               Quest：libopenxr_loader.so   （**Khronos 标准 loader** —— Meta 设备的
                      OpenXR 运行时由系统自带，应用侧用标准 loader 即可对接）
             以下声明对非 Quest 设备无副作用。

             ⚠️ 与 PICO 同理，VR 启动入口（category com.oculus.intent.category.VR）
                暂不加：loader 未接入前加上会让 Quest 把应用当 VR 应用启动随后失败。
                等标准 loader 就绪后再与 PICO 一并开启。 -->
        <meta-data android:name="com.oculus.supportedDevices" android:value="all" />
        <meta-data android:name="com.oculus.vr.focusaware" android:value="true" />

        <!-- ===== 华为 VR Glass 应用声明（官方 Manifest 规范）=====
             ⚠️ application.mode=vr_only 是 **VRLauncher 识别本应用的核心** ——
                缺它则插上 VR Glass 后在「华为 VR」内容库里看不到本应用。
             type=video 影响温控策略（播放器选 video；游戏才选 game）。
             freeDegree=3dof：本应用是播放器，不需要 6DoF 空间定位。
             max_aspect 为华为 VR 要求的值。
             ⚠️ 不要加 com.huawei.android.vr.sensor.mode=mobile ——
                那是调试期让眼镜用手机陀螺仪的临时项，正式包必须删除。 -->
        <meta-data android:name="com.huawei.android.vr.application.mode" android:value="vr_only" />
        <meta-data android:name="com.huawei.android.vr.application.type" android:value="video" />
        <meta-data android:name="com.huawei.vr.application.freeDegree" android:value="3dof" />
        <meta-data android:name="android.max_aspect" android:value="2.1" />

        <!-- ===== PICO VR 应用声明（PICO 官方 OpenXR 接入要求）=====
             对非 PICO 设备无副作用。
             pvr.sdk.version=OpenXR 表示走 OpenXR 路线（而非 PICO 旧的私有 PVRSDK），
             pxr.sdk.version_code 为 PICO OpenXR SDK 版本号。 -->
        <meta-data android:name="pvr.app.type" android:value="vr" />
        <meta-data android:name="pvr.sdk.version" android:value="OpenXR" />
        <meta-data android:name="pxr.sdk.version_code" android:value="5900" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout"
            android:theme="@style/Theme.MyApplication">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Support opening video files from other applications (e.g., file manager, chat, galleries) -->
            <intent-filter tools:ignore="AppLinkUrlError">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="file" />
                <data android:scheme="content" />
                <data android:scheme="http" />
                <data android:scheme="https" />
                <data android:mimeType="video/*" />
            </intent-filter>

            <!-- Support sharing video files/links into our application from shared streams -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="video/*" />
            </intent-filter>
        </activity>

        <!-- ====================================================================
             华为 VR Glass 播放 Activity（P0 骨架）
             ====================================================================
             · 它是官方「2D 应用 → VR」通道的接收方：外部用
               Intent().setPackage(pkg).setAction("com.huawei.android.vr.PROMPT") 拉起。
             · `android:exported="false"`：只允许本应用显式启动（用 setClass），
               action 声明保留是为了兼容华为 Runtime 的探测。
             · `vr_only` / `application.type` 等 meta-data 待真机验证后再启用。
             ==================================================================== -->
        <activity
            android:name="com.example.vr.huawei.HuaweiVrActivity"
            android:exported="true"
            android:label="@string/huawei_vr_enter"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|density|uiMode"
            android:launchMode="singleTask"
            android:theme="@style/Theme.MyApplication">
            <intent-filter>
                <action android:name="com.huawei.android.vr.PROMPT" />
                <category android:name="android.intent.category.DEFAULT" />
                <!-- ===== 各平台 VR 启动入口（缺一个就会在该平台的 VR 库中不可见）===== -->
                <!-- PICO（Neo3 / PICO 4 系列） -->
                <category android:name="com.picovr.intent.category.VR" />
                <!-- Meta Quest -->
                <category android:name="com.oculus.intent.category.VR" />
                <!-- Khronos OpenXR 标准（Android XR 等通用实现） -->
                <category android:name="org.khronos.openxr.intent.category.IMMERSIVE_HMD" />
            </intent-filter>
            <!-- 官方 VR 应用入口 action（官方示例 HVRSDK_XrDemo 的 MainActivity 同款）。
                 部分华为 VR Runtime / VrLauncher 版本用这个 action 来识别「支持 VR 的应用」，
                 比自建的 PROMPT 通道更标准。两条都声明，兼容性最好。 -->
            <intent-filter>
                <action android:name="com.huawei.android.vr.action.MAIN" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

            <!-- v2.0.205：**已移除**手机桌面的 MAIN/LAUNCHER 入口（用户要求）。
                 官方公告：HarmonyOS 3.0 起不声明 LAUNCHER 时，应用只在
                 「华为 VR - 内容库」里显示，手机桌面不出现图标 —— 即当前期望的行为。
                 如需调试期从手机桌面直接启动，可用 adb：
                   adb shell am start -n com.aistudio.vrplayer.vrmjpy/com.example.vr.huawei.HuaweiVrActivity -->
        </activity>

        <!-- ====================================================================
             PoC（临时，2026-09-29）：验证「共享 EGLContext 下 texture 互通 +
             跨 context fence 同步」是否可靠 —— 这是 GPUPixel texture 通道方案
             （见 GPUPIXEL_TEXTURE_PATH_FEASIBILITY_2026-09-29.md）唯一的未知项。
             验证结论落定后本段与 com.example.vr.poc 包可整体删除，不影响主功能。

             启动：adb shell am start -n \
               com.aistudio.vrplayer.vrmjpy/com.example.vr.poc.PocSharedContextActivity
             判据：统计行中 失配=0、GL错误=0、超时=0。
             ==================================================================== -->
        <activity
            android:name="com.example.vr.poc.PocSharedContextActivity"
            android:exported="true"
            android:label="PocSharedContext"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|density|uiMode" />
    </application>

</manifest>
