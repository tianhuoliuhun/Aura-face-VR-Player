<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />

    <!-- ========================================================================
         v2.1.228：**强制剔除依赖库夹带进来的权限**（tools:node="remove"）

         ⚠️ 教训：只改本文件是不够的 —— 最终 APK 的权限是「主清单 + 所有依赖库清单」
         合并的结果。此前我只 grep 了本文件、看到 6 条就以为干净了，
         实际用 `aapt2 dump permissions` 查 APK 发现有 **13 条**。
         下面这 5 条都是**没有任何依赖库会真正用到、本应用也完全不使用**的，
         其中广告相关的几条会让商店把它标成「含广告」并把 AD_ID 暴露给系统。

         核对方法（务必用这个而不是 grep 源码）：
             aapt2 dump permissions app/build/outputs/apk/release/*.apk
         ======================================================================== -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" tools:node="remove" />
    <!-- v2.1.230：移除 WAKE_LOCK。
         aapt 显示它来自依赖库合并；核对代码后确认：全项目只用 PowerManager
         读取热状态（THERMAL_STATUS_*），**读热状态不需要任何权限**，
         没有任何 newWakeLock() 调用。故用 remove 剔除。 -->
    <uses-permission android:name="android.permission.WAKE_LOCK" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_ADSERVICES_ATTRIBUTION" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_ADSERVICES_AD_ID" tools:node="remove" />
    <uses-permission android:name="com.google.android.finsky.permission.BIND_GET_INSTALL_REFERRER_SERVICE" tools:node="remove" />
    <!-- ⚠️ OPENXR_SYSTEM 是系统级签名权限（普通应用拿不到），
         我从主清单删过一次，但它又被某个依赖库合并了回来 ——
         所以这次用 remove 强制剔除，而不是再删一遍源码。 -->
    <uses-permission android:name="org.khronos.openxr.permission.OPENXR_SYSTEM" tools:node="remove" />
    <!-- v2.1.222：移除 READ_MEDIA_IMAGES
         全项目代码未读取图片库（演示图片走 assets/renderable，全程不需要该权限），
         属于不必要的权限 —— 应用商店会把它列成「读取你的相册」，去掉可减少隐私面。 -->
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />

    <!-- ========================================================================
         华为 VR Glass（VR Engine）接入，P0 阶段
         ========================================================================
         官方要求（键名逐条对照官方文档 / 参考项目 Manifest）：
           · GLES 3.2：<uses-feature glEsVersion="0x00030002">
             ⚠️ 这是**硬要求**，且属于「向后兼容」声明，声明 3.2 后，
                普通设备（只要能提供 3.x 上下文）依然可以安装，不影响现有用户。
           · 权限：com.huawei.android.permission.VR
                  com.huawei.vrhandle.permission.DEVICE_MANAGER
         ⚠️ v2.0.198 更新：`com.huawei.android.vr.application.mode=vr_only` **已启用**
            （见下方 application 内的 metadata）。此前因「怕影响 2D 启动行为」而保守搁置，
            但华为官方《申请应用适配华为 VR Glass 上架流程》明确说明：**缺它则 VRLauncher
            不识别本应用**，插上 VR Glass 后在「华为 VR」内容库里看不到 —— 是必需项而非可选项。
            `sensor.mode=mobile` 仍**不启用**（那是调试期临时项，正式包必须无）。
         ⚠️ XML 注释内不能出现连续的双连字符，所以本文件的分隔线只用「=」。
            曾因用了连字符分隔线导致 ManifestMerger 报 not well-formed。
         ======================================================================== -->

    <!-- GLES 3.2（华为硬要求）。required="false" 保证非华为设备不受影响 -->
    <uses-feature
        android:glEsVersion="0x00030002"
        android:required="false" />

    <!-- 华为 VR 权限（未装 VR 运行时的设备上仅是被忽略） -->
    <uses-permission android:name="com.huawei.android.permission.VR" />
    <uses-permission android:name="com.huawei.vrhandle.permission.DEVICE_MANAGER" />

    <!-- ===== PICO（Neo3 / PICO 4 系列）兼容声明 =====
         PICO 与华为都走 Android OpenXR，但各自使用**厂商定制的 loader**：
           华为：libxr_loader.so       （来自 huawei.vr.sdk.dir）
           PICO：libopenxr_loader.so   （来自 PICO OpenXR SDK，同样不入仓）
         下面这些声明对非 PICO 设备**无副作用**（未知 permission / metadata 仅被忽略），
         可与华为的声明共存。

         ⚠️ PICO 的 VR 启动入口（category com.picovr.intent.category.VR）**暂不加**：
            在 PICO 的 loader 接入之前加上，会让 PICO 把应用当 VR 应用启动、随后
            因找不到 loader 而失败 —— 比「不出现 VR 库」更糟。等 loader 就绪后再开启。
         ==================================================================== -->
    <uses-permission android:name="org.khronos.openxr.permission.OPENXR" />
    <!-- v2.1.222：移除 OPENXR_SYSTEM
         它是**系统级签名权限**（normal 应用无法获得、申请了也无效），
         属于 OpenXR 规范里给「系统级 XR 运行时」用的。普通第三方应用只需要
         OPENXR（runtime permission）即可，故移除这条无副作用、还能让权限清单更干净。 -->
    <!-- OpenXR 标准：标记为支持 VR 头显（required=false 保证普通 Android 设备不受影响） -->
    <uses-feature
        android:name="android.hardware.vr.headtracking"
        android:version="1"
        android:required="false" />
    <uses-feature android:name="oculus.software.handtracking" android:required="false" />

    <!-- API 30+ 包可见性：不声明则查不到华为 VR 运行时 -->
    <!--
        v2.1.222 说明：应用商店会把 <queries> 渲染成「获取应用列表」权限提示。
        这里**必须保留** —— 它不是「扫描用户装了什么应用」，而是**声明本应用
        运行时需要与哪几个特定系统服务通信**（且下面每一条都精确到包名/Action）：
          com.huawei.vrhandle / com.huawei.hvrsdkserverapp  —— 华为 VR Glass 手柄与运行时
          com.huawei.android.vr.PROMPT                  —— 华为 VR 接入提示
          org.khronos.openxr.OpenXRRuntimeService         —— 标准 OpenXR 运行时发现
        Android 11+ 若删掉这些，手柄发现与 OpenXR 运行时发现会**直接失效**
        （targetSdk>=30 时系统不再返回这些包信息），VR 设备上将搜不到手柄。
        这是**「显式列举」而非「全量查询」**，不涉及用户隐私数据。
    -->
    <queries>
        <package android:name="com.huawei.vrhandle" />
        <package android:name="com.huawei.hvrsdkserverapp" />
        <!-- targetSdk>=30 时不声明则搜不到手柄服务（官方规范明确列出） -->
        <intent>
            <action android:name="com.huawei.vrhandle.service.vrdeviceservice" />
        </intent>
        <intent>
            <action android:name="com.huawei.android.vr.PROMPT" />
        </intent>
        <!-- PICO / 标准 OpenXR：运行时服务发现（API 30+ 包可见性要求） -->
        <intent>
            <action android:name="org.khronos.openxr.OpenXRRuntimeService" />
        </intent>
    </queries>

    <application
        android:name=".AppApplication"
        android:allowBackup="true"
        android:usesCleartextTraffic="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyApplication">

        <!-- v107：统计由 Firebase Analytics 提供（google-services.json 配置，见 FIREBASE_ANALYTICS.md） -->

        <!-- ===== Meta Quest 应用声明 =====
             Quest 与 PICO / 华为一样走 Android OpenXR。三者的差异在 **loader 来源**：
               华为：libxr_loader.so        （华为 SDK 定制）
               PICO：libopenxr_loader.so    （PICO SDK 定制）
               Quest：libopenxr_loader.so   （**Khronos 标准 loader** —— Meta 设备的
                      OpenXR 运行时由系统自带，应用侧用标准 loader 即可对接）
             以下声明对非 Quest 设备无副作用。

             ⚠️ 与 PICO 同理，VR 启动入口（category com.oculus.intent.category.VR）
                暂不加：loader 未接入前加上会让 Quest 把应用当 VR 应用启动随后失败。
                等标准 loader 就绪后再与 PICO 一并开启。 -->
        <meta-data android:name="com.oculus.supportedDevices" android:value="all" />
        <meta-data android:name="com.oculus.vr.focusaware" android:value="true" />

        <!-- ===== 华为 VR Glass 应用声明（官方 Manifest 规范）=====
             ⚠️ application.mode=vr_only 是 **VRLauncher 识别本应用的核心** ——
                缺它则插上 VR Glass 后在「华为 VR」内容库里看不到本应用。
             type=video 影响温控策略（播放器选 video；游戏才选 game）。
             freeDegree=3dof：本应用是播放器，不需要 6DoF 空间定位。
             max_aspect 为华为 VR 要求的值。
             ⚠️ 不要加 com.huawei.android.vr.sensor.mode=mobile ——
                那是调试期让眼镜用手机陀螺仪的临时项，正式包必须删除。 -->
        <meta-data android:name="com.huawei.android.vr.application.mode" android:value="vr_only" />
        <meta-data android:name="com.huawei.android.vr.application.type" android:value="video" />
        <meta-data android:name="com.huawei.vr.application.freeDegree" android:value="3dof" />
        <meta-data android:name="android.max_aspect" android:value="2.1" />

        <!-- ===== PICO VR 应用声明（PICO 官方 OpenXR 接入要求）=====
             对非 PICO 设备无副作用。
             pvr.sdk.version=OpenXR 表示走 OpenXR 路线（而非 PICO 旧的私有 PVRSDK），
             pxr.sdk.version_code 为 PICO OpenXR SDK 版本号。 -->
        <meta-data android:name="pvr.app.type" android:value="vr" />
        <meta-data android:name="pvr.sdk.version" android:value="OpenXR" />
        <meta-data android:name="pxr.sdk.version_code" android:value="5900" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout"
            android:theme="@style/Theme.MyApplication">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Support opening video files from other applications (e.g., file manager, chat, galleries) -->
            <intent-filter tools:ignore="AppLinkUrlError">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="file" />
                <data android:scheme="content" />
                <data android:scheme="http" />
                <data android:scheme="https" />
                <data android:mimeType="video/*" />
            </intent-filter>

            <!-- v2.1.241：WMV / ASF / 光盘镜像的 mimeType 兜底。
                 ⚠️ 为什么 `video/*` 不够：WMV 的 MIME 在各家 provider 上五花八门
                    （video/x-ms-wmv / video/x-ms-asf / application/vnd.ms-asf），
                    部分系统版本上**不落在 video/* 通配范围内**；ISO 更是
                    application/x-iso9660-image。文件管理器广播时要靠这些精确
                    mimeType 才能把我们列进"打开方式"。
                 ⚠️ **必须另开一个 filter**：同一 filter 内多个 <data android:mimeType>
                    是「或」关系没错，但 mimeType 与上面那条的 scheme 组合会互相收窄，
                    分开写最不容易出错（与 v2.1.237 加 rtsp/rtmp 时同一个理由）。 -->
            <intent-filter tools:ignore="AppLinkUrlError">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="file" />
                <data android:scheme="content" />
                <data android:mimeType="video/x-ms-wmv" />
                <data android:mimeType="video/x-ms-asf" />
                <data android:mimeType="video/x-msvideo" />
                <data android:mimeType="application/vnd.ms-asf" />
                <data android:mimeType="application/x-iso9660-image" />
                <data android:mimeType="application/x-iso9660-appimage" />
            </intent-filter>

            <!-- v2.1.237：流媒体协议（与上面的 filter 分开写，**刻意不带 mimeType**）
                 ⚠️ 为什么必须另开一个 filter：intent-filter 内多个 <data> 是**与**关系，
                    上面那个带 `video/*`，而 HLS 的 .m3u8 是 application/x-mpegURL、
                    RTSP/RTMP 根本没有 mimeType → 全都匹配不上上面那条，
                    链接点"打开方式"时不会出现本应用。
                 不带 mimeType 的 scheme-only filter 才能接收这些。
                 ⚠️ 这里**只加 rtsp/rtmp**，没把 http/https 也放进无 mimeType 的 filter ——
                    否则本应用会出现在**所有网页链接**的打开方式里，属于骚扰用户。
                    （因此浏览器里的 .m3u8 链接仍要靠"分享"或应用内输入地址；
                      如果需要一个"输入网络地址"的入口，那是另一个 UI 需求。） -->
            <intent-filter tools:ignore="AppLinkUrlError">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="rtsp" />
                <data android:scheme="rtmp" />
            </intent-filter>

            <!-- Support sharing video files/links into our application from shared streams -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="video/*" />
            </intent-filter>
        </activity>

        <!-- ====================================================================
             华为 VR Glass 播放 Activity（P0 骨架）
             ====================================================================
             · 它是官方「2D 应用 → VR」通道的接收方：外部用
               Intent().setPackage(pkg).setAction("com.huawei.android.vr.PROMPT") 拉起。
             · `android:exported="false"`：只允许本应用显式启动（用 setClass），
               action 声明保留是为了兼容华为 Runtime 的探测。
             · `vr_only` / `application.type` 等 meta-data 待真机验证后再启用。
             ==================================================================== -->
        <activity
            android:name="com.example.vr.huawei.HuaweiVrActivity"
            android:exported="true"
            android:label="@string/huawei_vr_enter"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|density|uiMode"
            android:launchMode="singleTask"
            android:theme="@style/Theme.MyApplication">
            <intent-filter>
                <action android:name="com.huawei.android.vr.PROMPT" />
                <category android:name="android.intent.category.DEFAULT" />
                <!-- ===== 各平台 VR 启动入口（缺一个就会在该平台的 VR 库中不可见）===== -->
                <!-- PICO（Neo3 / PICO 4 系列） -->
                <category android:name="com.picovr.intent.category.VR" />
                <!-- Meta Quest -->
                <category android:name="com.oculus.intent.category.VR" />
                <!-- Khronos OpenXR 标准（Android XR 等通用实现） -->
                <category android:name="org.khronos.openxr.intent.category.IMMERSIVE_HMD" />
            </intent-filter>
            <!-- 官方 VR 应用入口 action（官方示例 HVRSDK_XrDemo 的 MainActivity 同款）。
                 部分华为 VR Runtime / VrLauncher 版本用这个 action 来识别「支持 VR 的应用」，
                 比自建的 PROMPT 通道更标准。两条都声明，兼容性最好。 -->
            <intent-filter>
                <action android:name="com.huawei.android.vr.action.MAIN" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

            <!-- v2.0.205：**已移除**手机桌面的 MAIN/LAUNCHER 入口（用户要求）。
                 官方公告：HarmonyOS 3.0 起不声明 LAUNCHER 时，应用只在
                 「华为 VR - 内容库」里显示，手机桌面不出现图标 —— 即当前期望的行为。
                 如需调试期从手机桌面直接启动，可用 adb：
                   adb shell am start -n com.aistudio.vrplayer.vrmjpy/com.example.vr.huawei.HuaweiVrActivity -->
        </activity>

        <!-- ====================================================================
             PoC（临时，2026-09-29）：验证「共享 EGLContext 下 texture 互通 +
             跨 context fence 同步」是否可靠 —— 这是 GPUPixel texture 通道方案
             （见 GPUPIXEL_TEXTURE_PATH_FEASIBILITY_2026-09-29.md）唯一的未知项。
             验证结论落定后本段与 com.example.vr.poc 包可整体删除，不影响主功能。

             启动：adb shell am start -n \
               com.aistudio.vrplayer.vrmjpy/com.example.vr.poc.PocSharedContextActivity
             判据：统计行中 失配=0、GL错误=0、超时=0。
             ==================================================================== -->
        <activity
            android:name="com.example.vr.poc.PocSharedContextActivity"
            android:exported="true"
            android:label="PocSharedContext"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|density|uiMode" />
    </application>

</manifest>
